{
  "name": "lambada",
  "private": true,
  "description": "Lint/test task runner for lambada (JS via npm scripts, Go via golangci-lint/gorderly)",
  "scripts": {
    "test": "vitest run && go test -v ./... | gorderly -fv",
    "lint-js": "standard --fix",
    "test-js": "vitest run",
    "lint-go": "golangci-lint run --fix",
    "test-go": "go test -v ./... | gorderly -fv",
    "lint-html": "html-validate --ext=tmpl,html cmd/lambada-web/views/ www/",
    "format-go": "go fmt ./...",
    "check": "standard && vitest run --reporter=dot && golangci-lint run && LOG_QUIET=1 go test ./... && npm run lint-html",
    "test-webdav": "vitest run --config vitest.webdav.config.js",
    "serve": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "html-validate": "^11.5.6",
    "humane-ts": "github:woodie/humane-ts",
    "jsdom": "^30.1.2",
    "sinon": "^19.0.2",
    "standard": "^17.1.2",
    "vitest": "^4.1.10"
  },
  "standard": {
    "env": [
      "browser"
    ],
    "globals": [
      "context"
    ],
    "ignore": [
      "www/vendor/"
    ]
  }
}
